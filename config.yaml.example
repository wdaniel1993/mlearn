# mlearn configuration — all knobs in one place.
# Copy to config.yaml (gitignored) and adjust.

# --- Buffer (never generate on the critical path of a request) ---
buffer_target: 20        # aim for this many status='ready' cards
buffer_floor: 8          # drop below -> trigger a generation run
batch_size: 12           # cards produced per run

# --- Serving ---
daily_cap: 5             # max discovery cards served per day (morning push)
discovery_ratio: 0.7     # legacy; mornings are pure discovery now
retention_target: 0.9    # FSRS retention target
daily_retention_cap: 5   # evening spaced-repetition prompts per day
taste_strength: 1.0      # granular (embedding-level) feedback weight; 0 disables

# --- Novelty / exploration ---
wildcard_rate: 0.15      # share of generation slots for wildcard topics
exploration_floor: 0.03  # min allocation probability per cluster

# --- Dedupe / profile ---
dedupe_threshold: 0.92   # cosine above this -> near-duplicate, discard
profile_lambda: 0.1      # EMA step for the interest vector

# --- Taste decay (weekly) ---
decay_factor: 0.95

# --- Source probation ---
probation_cards: 20      # served cards before promotion review
max_probation_sources: 3 # cap on concurrent probation sources

# --- Paths ---
paths:
  data_dir: data
  raw_dir: data/raw
  cards_dir: cards        # markdown projection output
  db: data/app.db
  sources: sources.yaml
  config: config.yaml

# --- Generation model (operator-set) ---
generate:
  provider: local         # openrouter | local (OpenAI-compatible endpoint)
  model: deepseek-v4-flash
  base_url: http://127.0.0.1:8642/v1
  api_key_env: API_SERVER_KEY
  temperature: 0.4
  max_retries: 3
  reasoning_effort: max   # DeepSeek-family: max reasoning (generation quality)

# --- Embeddings (always local — small model, rarely re-embedded) ---
embed:
  provider: local
  model: BAAI/bge-small-en-v1.5

# --- Optional read API ---
api:
  host: 127.0.0.1
  port: 8311

# --- Topic catalog (the top-level categories) ---
# The initial clusters are born from this list; generation guardrails and the
# round-robin allocation follow it. Add / remove / rename freely — a fresh
# `mlearn init` seeds exactly these. Any topic NOT listed here gets the
# generic mechanism guardrail (and clusters born later via the wildcard arm
# are handled the same way). Omitting the section uses the built-in defaults
# (see mlearn/config.py DEFAULTS["topics"]).
topics:
  - name: self_improvement
    guardrail: >-
      Topic self_improvement — require a study, dataset, or primary account
      in the article. Reject anything whose substance is exhortation.
  - name: mental_health
    guardrail: >-
      Topic mental_health — MECHANISM AND RESEARCH ONLY: explain mechanisms
      and evidence. NEVER prescriptive, never framed as addressing the
      reader's own condition, never diagnostic.
  - name: innovation
    guardrail: "Topic innovation — explain the mechanism behind the innovation or idea."
  - name: technology
    guardrail: "Topic technology — explain the mechanism of the technology: how it works, why."
  - name: finance
    guardrail: >-
      Topic finance — how instruments, markets, and mechanisms work. NEVER
      buy/sell/allocate guidance, never specific-security recommendations.
  - name: psychology
    guardrail: >-
      Topic psychology — how the mind works: mechanisms, biases, effects,
      and their evidence. NEVER diagnostic, NEVER prescriptive.